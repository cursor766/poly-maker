{
  "name": "poly-maker",
  "version": "1.0.0",
  "description": "MQTT-backed fair odds feed and safe Polymarket market maker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "observe": "tsx src/index.ts",
    "discover": "DISCOVERY_MODE=true tsx src/index.ts",
    "web:api": "tsx src/web/server.ts",
    "web:dev": "pnpm --dir web dev",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.31.0",
  "dependencies": {
    "@polymarket/bindings": "^0.2.0",
    "@polymarket/client": "^0.2.0",
    "@polymarket/clob-client": "^5.8.1",
    "dotenv": "^17.4.2",
    "mqtt": "^5.15.2",
    "pino": "^10.3.1",
    "viem": "^2.55.10",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
